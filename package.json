{
  "name": "@reasonable-stack/orm",
  "version": "0.1.0",
  "description": "A reasonably good ORM for SQL databases on TypeScript.",
  "author": "Rafael Willians <me@rwillians.com>",
  "keywords": ["bun", "maria", "mariadb", "mysql", "orm", "pg", "postgres", "sql", "sqlite", "sqlite3"],
  "publishConfig": {
    "access": "public"
  },
  "files": ["LICENSE", "dist/*"],
  "repository": {
    "type": "git",
    "url": "git://github.com/reasonable-stack/orm.git"
  },
  "bugs": {
    "url": "https://github.com/reasonable-stack/orm/issues"
  },
  "type": "module",
  "module": "dist/esm/index.js",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./bun-sqlite": {
      "import": {
        "types": "./dist/esm/bun-sqlite.d.ts",
        "default": "./dist/esm/bun-sqlite.js"
      },
      "require": {
        "types": "./dist/cjs/bun-sqlite.d.ts",
        "default": "./dist/cjs/bun-sqlite.js"
      }
    },
    "./bun-postgres": {
      "import": {
        "types": "./dist/esm/bun-postgres.d.ts",
        "default": "./dist/esm/bun-postgres.js"
      },
      "require": {
        "types": "./dist/cjs/bun-postgres.d.ts",
        "default": "./dist/cjs/bun-postgres.js"
      }
    },
    "./experimental-migrations": {
      "import": {
        "types": "./dist/esm/experimental-migrations.d.ts",
        "default": "./dist/esm/experimental-migrations.js"
      },
      "require": {
        "types": "./dist/cjs/experimental-migrations.d.ts",
        "default": "./dist/cjs/experimental-migrations.js"
      }
    }
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "build": "bun run build:cjs && bun run build:esm",
    "build:cjs": "bun run --bun tsc --project tsconfig-cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build:esm": "bun run --bun tsc --project tsconfig-esm.json",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@reasonable-stack/datetime": "^0.2.0",
    "@types/bun": "latest",
    "zod": "^4"
  },
  "peerDependencies": {
    "@reasonable-stack/datetime": ">=0.2.0",
    "typescript": ">=5.4.0"
  }
}
